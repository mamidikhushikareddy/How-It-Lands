{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core user metadata and billing/subscription information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "plus", "pro"] },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "created_at": { "type": "string", "format": "date-time" },
        "onboarding_completed": { "type": "boolean" },
        "usage_count_month": { "type": "integer" },
        "credit_balance": { "type": "integer" }
      },
      "required": ["id", "email", "plan", "role", "created_at"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User specific communication style preferences and settings.",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "communication_style": { "type": "string" },
        "overdo_patterns": { "type": "array", "items": { "type": "string" } },
        "preferred_tone": { "type": "string" },
        "preserve_voice": { "type": "boolean" },
        "favorite_phrases": { "type": "array", "items": { "type": "string" } },
        "avoided_phrases": { "type": "array", "items": { "type": "string" } },
        "default_scenario": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["user_id"]
    },
    "Analysis": {
      "title": "Analysis",
      "description": "Saved emotional and strategic communication analyses generated by Gemini.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "original_message": { "type": "string" },
        "scenario": { "type": "string" },
        "relationship_context": { "type": "string" },
        "user_goal": { "type": "string" },
        "extra_context": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "saved": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "output_json": { "type": "object" }
      },
      "required": ["id", "user_id", "title", "original_message", "scenario", "created_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Root collection for user metadata."
    },
    "/users/{userId}/profiles/main": {
      "schema": "UserProfile",
      "description": "User communication profile preferences."
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "User strategic conversation analyses."
    }
  }
}
