
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Postgres connection string for local development.
# Set this in .env.local when running the app locally.
DATABASE_URL=""

# VITE_GOOGLE_CLIENT_ID: Google OAuth Client ID for Social Sign-In using @react-oauth/google.
# Set this value to your Google Cloud Console Web Application Client ID.
VITE_GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Google OAuth Client Secret (managed server-side, never exposed to browser)
# Set this value to your Google Cloud Console Web Application Client Secret.
GOOGLE_CLIENT_SECRET=""

# SMTP Transactional Email Settings (e.g. for Gmail or external SMTP relay)
# Set these in your AI Studio secrets to enable real email deliveries to users' gmails.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=
WEBHOOK_SECRET=
