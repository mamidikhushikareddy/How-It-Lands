# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Google OAuth Client ID for Social Sign-In using @react-oauth/google.
# Set this value to your Google Cloud Console Web Application Client ID.
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: Google OAuth Client Secret (managed server-side, never exposed to browser)
# Set this value to your Google Cloud Console Web Application Client Secret.
GOOGLE_CLIENT_SECRET=""

# SMTP Transactional Email Settings (e.g. for Gmail or external SMTP relay)
# Set these in your AI Studio secrets to enable real email deliveries to users' gmails.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"

# SUPER_ADMIN_EMAILS: Comma-separated list of approved Super Admin email addresses.
# Only authenticated users matching these verified email addresses receive Super Admin privileges and Admin Terminal access.
SUPER_ADMIN_EMAILS="kiaria2514@gmail.com"

# ============================================================
# PRODUCT ANALYTICS & REPLAY CONFIGURATION (PHASE G)
# ============================================================
# VITE_GA4_MEASUREMENT_ID: Google Analytics 4 Web Stream Measurement ID (format: G-XXXXXXXXXX).
# Direct tracking is enabled when present, unless VITE_GTM_CONTAINER_ID is active.
VITE_GA4_MEASUREMENT_ID=""

# VITE_GTM_CONTAINER_ID: Google Tag Manager Container ID (format: GTM-XXXXXXX).
# When provided, all events route through dataLayer to avoid double-counting.
VITE_GTM_CONTAINER_ID=""

# VITE_MIXPANEL_TOKEN: Mixpanel Project Token.
# Events are dispatched via mixpanel-browser with strict IP anonymization (ip: false).
VITE_MIXPANEL_TOKEN=""

# VITE_AMPLITUDE_API_KEY: Amplitude Browser API Key.
# Initialized via @amplitude/analytics-browser with defaultTracking disabled.
VITE_AMPLITUDE_API_KEY=""

# VITE_CLARITY_PROJECT_ID: Microsoft Clarity Project ID.
# Visual session replay and heatmaps with comprehensive text and communication masking.
VITE_CLARITY_PROJECT_ID=""

